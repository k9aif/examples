        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="AGN2 – Exception Resolution Agent">
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_review_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="AGN3 – GL Coding Agent">
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_review_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="AGN4 – Anomaly Detection Agent">
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="AGN5 – Payment Optimization Agent">
        <bpmn:flowNodeRef>Task_9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_6" name="AGN6 – Expense Audit Agent">
        <bpmn:flowNodeRef>Task_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_review_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_7" name="AGN7 – Vendor Master Agent">
        <bpmn:flowNodeRef>Task_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_13_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_review_4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_1" name="Receive &amp; Digitize Invoice">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_2" name="Validate Invoice Completeness">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:businessRuleTask id="Task_3" name="Match Invoice to Purchase Order">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:serviceTask id="Task_4" name="Detect Matching Exceptions">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_4_review" name="Review: Detect Matching Exceptions">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_review_1" name="Approved?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_5" name="Classify &amp; Code GL Account">
