# FinancialAnalysisAi — environment variable reference
# Copy to .env and fill in values. Never commit .env to source control.
# Generated by k9x_studio on 2026-09-10 23:47:14

# ── K9-AIF Framework path ────────────────────────────────
# Absolute path to your k9-aif-framework clone.
# Do not use ~ — use the full path.
K9_FRAMEWORK_PATH=

# ── LLM — Ollama (default, local, no key needed) ─────────
OLLAMA_BASE_URL=http://localhost:11434

# ── LLM — OpenAI ─────────────────────────────────────────
# Set backend: openai and api_key_env: OPENAI_API_KEY in config.yaml
OPENAI_API_KEY=

# ── LLM — Grok / xAI ─────────────────────────────────────
# Set backend: openai-compatible and api_key_env: GROK_API_KEY in config.yaml
GROK_API_KEY=

# ── Advanced / optional infrastructure ───────────────────
# Not used by this scaffold's config.yaml. Uncomment if you extend
# it with Kafka, Postgres, Neo4j, or Redis — see the EOC example
# in k9-aif-framework/examples/ for a config.yaml that wires these in.
# KAFKA_BROKER=localhost:9092
# POSTGRES_HOST=localhost
# POSTGRES_USER=postgres
# POSTGRES_DB=financial_analysis_ai
# K9_PG_PASSWORD=
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── App ──────────────────────────────────────────────────
APP_NAME=FinancialAnalysisAi
APP_DOMAIN=finance
