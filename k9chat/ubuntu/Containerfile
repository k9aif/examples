# SPDX-License-Identifier: Apache-2.0
# k9chat — generic, no-op-by-default reference Containerfile (no real
# secrets). Build context must be ai/ (parent of both k9-aif-framework/
# and this repo, k9-aif-examples/) -- k9chat imports k9_aif_abb/ directly
# rather than pip-installing it (PyPI's k9-aif lags behind the framework
# repo), so both repos need to be in the build context together. Clone
# k9-aif-framework as a sibling of this repo first -- see this repo's
# k9chat/README.md.
#
# Build (from ai/, the parent of both repos):
#   podman build -t k9chat:latest \
#     --build-arg K9AIF_DIR=k9-aif-framework \
#     --build-arg K9EXAMPLES_DIR=k9-aif-examples \
#     --build-arg K9CHAT_VERSION=$(git -C k9-aif-examples rev-parse --short HEAD) \
#     -f k9-aif-examples/k9chat/ubuntu/Containerfile .
# (build-run.sh does this for you.)

ARG K9AIF_DIR=k9-aif-framework
ARG K9EXAMPLES_DIR=k9-aif-examples
# Short git commit hash of the k9-aif-examples checkout this image was
# built from -- the container has no .git of its own (only k9_aif_abb/ +
# k9chat/ are copied in), so chat.py's get_k9chat_version() can't
# discover this itself. build-run.sh computes this from the host's
# checkout and passes it in via --build-arg; without the ARG/ENV pair
# below to actually consume it, podman just silently drops the value
# (confirmed live 2026-09-21: "one or more build args were not consumed:
# [K9CHAT_VERSION]" -- this Containerfile was missing both lines entirely,
# a real mistake introduced when this file was rewritten earlier today).
ARG K9CHAT_VERSION=unknown

FROM registry.access.redhat.com/ubi9/python-311:latest
ARG K9AIF_DIR
ARG K9EXAMPLES_DIR
ARG K9CHAT_VERSION
ENV K9CHAT_VERSION=${K9CHAT_VERSION}

USER root
WORKDIR /app

COPY ${K9EXAMPLES_DIR}/k9chat/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip
# CPU-only torch first, from PyTorch's own CPU wheel index -- a plain
# `pip install torch` on Linux x86_64 pulls the multi-GB CUDA-bundled
# build by default, which this container has no use for (no GPU access;
# Ollama runs outside it entirely; torch here is only sentence-transformers'
# dependency for the FAQ reranker's CrossEncoder). PEP 440 local-version
# matching does not reliably hold across two *separate* pip invocations
# (confirmed live 2026-09-20: pip re-resolved against the default index
# anyway and pulled the full CUDA 13 stack), so it's installed in this same
# step rather than left to sentence-transformers to pull in on its own.
#
# requirements.txt here is k9chat's own scoped list (see that file's header)
# -- not the framework's full requirements.txt, which installs ~40 packages
# (CrewAI, Kafka clients aside, Neo4j, Kubernetes client, MCP, Claude Agent
# SDK, Cohere, LiteLLM, LanceDB, Qdrant client, S3) that k9chat's own
# reachable import graph never touches (confirmed empirically 2026-09-21).
RUN pip install --no-cache-dir torch==2.14.0 \
      --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r requirements.txt

COPY ${K9AIF_DIR}/k9_aif_abb ./k9_aif_abb
COPY ${K9EXAMPLES_DIR}/k9chat ./k9chat

# /app/data (bind-mounted at runtime) holds .chroma/ and the projects
# sqlite db, so they persist across image rebuilds -- see build-run.sh's
# K9CHAT_CHROMA_PATH/K9CHAT_PROJECTS_DB overrides.
RUN mkdir -p /app/data \
 && chown -R 1001:0 /app \
 && chmod -R g+rwX /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=7777

EXPOSE 7777

HEALTHCHECK --interval=30s --timeout=8s --start-period=15s --retries=3 \
  CMD python -c "import socket; socket.create_connection(('localhost', 7777), timeout=3).close()" \
      || exit 1

USER 1001

CMD ["python", "-m", "uvicorn", "k9chat.app:app", "--host", "0.0.0.0", "--port", "7777"]
