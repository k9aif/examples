# Copy to .env and edit. .env is never committed.

# Your Ollama server (it serves the OpenAI-compatible API under /v1).
# In the container (ubuntu/build-run.sh) use the host's LAN address, not localhost.
OLLAMA_BASE_URL=http://localhost:11434

# The tool-calling model for the WeatherAgent (pull it first: ollama pull qwen2.5:7b).
WEATHER_MODEL=qwen2.5:7b

# development keeps the Zero Trust identity warning soft; build-run.sh sets production in the container.
K9_ENV=development

# Page port for ./run.sh (the container listens on 8121; build-run.sh's HOST_PORT changes that).
PORT=8003

# Optional: a local framework checkout instead of PyPI.
# K9_FRAMEWORK_DIR=/path/to/k9-aif-framework

# Requests a minute per visitor on the page (public hosting).
WEATHER_RATE_PER_MIN=6

# Demo sign-in shown on the landing page (demo login only; there is no admin account).
DEMO_USER=demo
DEMO_PASSWORD=demo
# Signs session cookies. Set it in production; unset = random per start (everyone signed out on restart).
# SESSION_SECRET=

# ── Accounts payable + K9X HIL (use case 3). Off unless KAFKA_BOOTSTRAP_SERVERS is set. ──
# In the container use LAN addresses, not localhost.
# The shared Redpanda (the same one das.k9x.ai uses).
# KAFKA_BOOTSTRAP_SERVERS=redpanda-host:9092
# The K9X Rules Engine (k9x-ecosystem/k9x_rules_engine; LAN only).
# K9X_RULES_ENGINE_URL=http://rules-host:8130
# K9X HIL's REST API for the page's HIL pane. The key must match HIL_API_KEY on the HIL server; it never reaches a browser.
# HIL_API_URL=https://hil.k9x.ai
# HIL_API_KEY=
# Where paused flows and OpenAI runs wait: PostgreSQL (database k9x, schema openai, created on first start) when true;
# otherwise SQLite under runtime/ (lost when the container is replaced).
# AP_POSTGRES_ENABLED=true
# POSTGRES_HOST=postgres-host
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# AP_POSTGRES_DB=k9x
# AP_POSTGRES_SCHEMA=openai
# Invoices still in flight per visitor.
# AP_OPEN_PER_SESSION=3
