# Copy to .env and edit. .env is never committed.

# Your Ollama server (it serves the OpenAI-compatible API under /v1).
# In the container (ubuntu/build-run.sh) use the host's LAN address, not localhost.
OLLAMA_BASE_URL=http://localhost:11434

# The tool-calling model for the WeatherAgent (pull it first: ollama pull qwen2.5:7b).
WEATHER_MODEL=qwen2.5:7b

# development keeps the Zero Trust identity warning soft; build-run.sh sets production in the container.
K9_ENV=development

# Page port for ./run.sh (the container listens on 8121; build-run.sh's HOST_PORT changes that).
PORT=8003

# Optional: a local framework checkout instead of PyPI.
# K9_FRAMEWORK_DIR=/path/to/k9-aif-framework

# Requests a minute per visitor on the page (public hosting).
WEATHER_RATE_PER_MIN=6

# Demo sign-in shown on the landing page (demo login only; there is no admin account).
DEMO_USER=demo
DEMO_PASSWORD=demo
# Signs session cookies. Set it in production; unset = random per start (everyone signed out on restart).
# SESSION_SECRET=
